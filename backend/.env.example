# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不会进入版本库。
APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL 连接串（本地开发默认库 crispy_a / 用户 crispy）
DATABASE_URL=postgres://crispy:change-me@127.0.0.1:5432/crispy_a?sslmode=disable

# 鉴权：JWT_SECRET 至少 32 字符，生产环境用 `openssl rand -base64 48` 重新生成
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# 首次启动且 users 表为空时自动创建的管理员账号；留空则不创建
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# 允许跨域访问的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173
# 生产环境走 HTTPS 时置为 true，refresh cookie 才会带 Secure 标记
COOKIE_SECURE=false
