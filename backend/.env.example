# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不会进入版本库。
APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL 连接串（本地开发默认库 crispy_a / 用户 crispy）
DATABASE_URL=postgres://crispy:change-me@127.0.0.1:5432/crispy_a?sslmode=disable

# 鉴权：JWT_SECRET 至少 32 字符，模板故意留空，必须自行生成，例如：
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# 首次启动且 users 表为空时创建管理员；两项必须同时填写或同时留空。
# 仅在初始化时生效，之后修改不会更新已存在的账号。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 允许跨域访问的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173
# 生产环境走 HTTPS 时置为 true，refresh cookie 才会带 Secure 标记
COOKIE_SECURE=false
