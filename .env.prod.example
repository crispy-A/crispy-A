# Docker Compose 生产配置模板。
# 用法：复制为 .env.prod，填好真实值，chmod 600 .env.prod，且不要提交到 Git。
# 注意：值不要加引号；数据库密码建议只用字母数字（会拼进 DATABASE_URL）。

POSTGRES_DB=crispy_a
POSTGRES_USER=crispy
POSTGRES_PASSWORD=change-me-strong-db-password

# 生成：openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

# 仅首次启动（users 表为空）时创建管理员；建好后可从本文件删除这两项。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# 必须与浏览器访问的地址完全一致（无尾斜杠）；同源反代下也必须写对。
CORS_ORIGINS=https://example.com

# 生产必须 true，并且站点必须是 HTTPS。
COOKIE_SECURE=true

# 仅绑定在 127.0.0.1，由宿主机 Nginx 反代；不要改成 0.0.0.0。
API_PORT=8080

# 仅 --profile web 时使用。
WEB_PORT=8081
